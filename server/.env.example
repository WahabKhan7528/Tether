# ───────────────────────────────────────────────────────────────
# Tether — Server Environment Variables
# Copy this file to .env and fill in the values.
# ───────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
PORT=5000

# MongoDB connection string — REQUIRED
# Local: mongodb://127.0.0.1:27017/tether
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/tether
MONGODB_URI=

# ── Server & Client URLs ──────────────────────────────────────
# Local URLs
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Production URLs (Render backend, Vercel frontend)
# SERVER_URL=https://tether-l3e0.onrender.com
# CLIENT_URL=https://tether-six-omega.vercel.app

# ── JWT & CSRF (cookie-based, always required) ──────────────
# Authentication is now always JWT cookie-based. No bypass mode.
# Generate strong secrets (run once — each should be DIFFERENT):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Dedicated secret for CSRF token signing (separate from JWT secrets)
CSRF_SECRET=

# ── Storage Mode ──────────────────────────────────────────────
# Storage has been simplified to use ImageKit exclusively for uploads.
STORAGE_MODE=imagekit

# ── ImageKit — required when STORAGE_MODE=imagekit ────────────
# Sign up free at https://imagekit.io
# Dashboard → Developer Options → API Keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id


# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
